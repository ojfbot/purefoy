# purefoy — environment variable reference
# Copy to .env.local (gitignored) and set real values

# ── packages/api ──────────────────────────────────────────────────────────────
PORT=3021

# Absolute or relative path to the downloads/ directory containing episode dirs
# Default: resolved relative to packages/api/ → ../../downloads (repo root)
DOWNLOADS_DIR=./downloads

# Absolute or relative path to library/ directory containing forum JSON + SQLite
# Default: resolved relative to packages/api/ → ../../library (repo root)
LIBRARY_DIR=./library

# ── packages/browser-app ──────────────────────────────────────────────────────
# Base URL for purefoy-api (VITE_ prefix required for Vite env injection into bundle)
VITE_API_URL=http://localhost:3021

# Shell host origin — used for CORS allowlist in vite preview
# SHELL_ORIGIN=http://localhost:4000
